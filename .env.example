# Local Ghost configuration used only by the legacy migration workflow.
GHOST_URL=http://localhost:2368
GHOST_CONTENT_API_KEY=replace-with-a-content-api-key
GHOST_ADMIN_API_KEY=replace-with-an-admin-api-key

# Optional: parent directory containing Yoga, Naruse, and Nakayama photo folders
# for the legacy update_post.js migration script.
SAKURA_PHOTOS_DIR=/absolute/path/to/Sakura
